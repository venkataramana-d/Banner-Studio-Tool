# Persistence (optional).
# Leave unset to use the built-in file/mock store (ephemeral on Vercel).
# Set a Postgres connection string to switch on real, shared persistence.
#
# On Vercel: add a Vercel Postgres or Neon integration and this is populated
# automatically (as POSTGRES_URL) - no code change needed, just redeploy.
#
# Locally: copy this file to .env.local and paste your Neon connection string.
# POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# DATABASE_URL is also accepted as an alias.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
